{
  "name": "baton",
  "version": "0.3.2",
  "private": true,
  "description": "The standup that remembers yesterday — a daily standup tracker that carries unfinished work forward.",
  "license": "Apache-2.0",
  "author": "Parth Satodiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParthSatodiya/baton.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/standup.test.ts",
    "backup": "node scripts/backup.mjs",
    "seed:demo": "DATABASE_URL=\"file:./prisma/demo.db\" prisma migrate deploy && DATABASE_URL=\"file:./prisma/demo.db\" node scripts/seed-demo.mjs",
    "demo": "npm run seed:demo && DATABASE_URL=\"file:./prisma/demo.db\" DEMO_MODE=1 next dev",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "13.0.3",
    "date-fns": "^4.4.0",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^6"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2",
    "sharp": "^0.35.5"
  }
}
